<div class="card-container">
    <% if(locals.project){ %>
        <div class="img-container">
            <img src="<%= project.imgUrl %>" alt="">
        </div>
        <div class="content-container">
            <div class="upper-content">
                <h3 class="project-title">
                    <%= project.Title %>
                </h3>
                <p class="project_description_short">
                    <%= project.Short_Description %>
                </p>
                <div class="sections">
                    <% project.Tabs.forEach(function (tab, i) { %>
                        <button type="button" class="tab-btn<%= i === 0 ? ' active' : '' %>" data-tab="<%= i %>">
                            <%= tab.label %>
                        </button>
                        <% }) %>
                </div>
            </div>
            <!-- require a number flag to select the data of the particular tab -->
            <div class="project-data">
                <% project.Tabs.forEach(function (tab, i) { %>
                    <div class="tab-panel" data-panel="<%= i %>" <%=i===0 ? '' : 'hidden' %>>
                        <p><%- tab.Reason %></p>
                    </div>
                    <% }) %>
            </div>
            <div class="tech-stack">
                <% for(const skill of project.Tech_Stack){ %>
                    <div>
                        <%= skill %>
                    </div>
                    <% } %>
            </div>
            <div class="controls">
                <button class="btn1" type="button">Visit Live Site</button>
                <button class="btn2" type="button">View Source</button>
            </div>
            <% } %>
        </div>
</div>